# Copy this file to .env before running `agentengine dev up` or `npm run dev`.
# `agent.yaml` owns app metadata, feature flags, and optional model hints.
# `.env` should only contain local secrets and environment-specific endpoints.

# MongoDB connection used by Magenta for LangGraph checkpoints and traces.
# Leave empty for local `agentengine dev`; the CLI provides its local MongoDB URI.
MONGODB_URI=

# Runtime database for checkpoints and traces.
MDB_AGENTIC_STORE_DB=mdb_store_agent_atlas_explorer_local

# Atlas Managed MCP client credentials. Create a dedicated MCP configuration
# in Atlas, allowlist this environment's egress IP, and copy its credentials
# here. Magenta exchanges them for short-lived OAuth access tokens.
ATLAS_MCP_CLIENT_ID=
ATLAS_MCP_CLIENT_SECRET=

# Optional Magenta secret. Leave unset, empty, or "false" to keep the agent
# read-only. Any other non-empty value exposes write MCP tools.
ALLOW_WRITE_OPERATIONS=

# LLM credentials. main.ts selects OpenAI by default. If you change the
# provider in code, set the corresponding key and update agent.yaml.

# Anthropic API key.
ANTHROPIC_API_KEY=
# Optional Anthropic-compatible base URL (e.g. Grove Foundry).
ANTHROPIC_BASE_URL=

# Google Gemini API key.
GEMINI_API_KEY=

# OpenAI or OpenAI-compatible API key.
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (e.g. Grove Foundry, Azure OpenAI).
OPENAI_BASE_URL=
# Required when OPENAI_BASE_URL targets Azure OpenAI.
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# auto (default), true, or false. Reasoning models use Responses by default.
OPENAI_USE_RESPONSES_API=auto

# Cerebras API key.
CEREBRAS_API_KEY=
