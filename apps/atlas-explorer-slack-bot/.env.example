# Slack credentials for both local Socket Mode and Vercel HTTP mode.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Required only for local Socket Mode. Create an app-level token with
# connections:write.
SLACK_APP_TOKEN=
# Optional. Slack Web API base URL. Leave unset to call https://slack.com/api.
# Local integration tests set this to a stand-in so CI never calls Slack.
# SLACK_API_URL=http://127.0.0.1:4011/api
# Optional. Overrides slackBotConfig.name in src/config.ts, which defaults to
# AtlasExplorer.
SLACK_BOT_DISPLAY_NAME=

# Required comma-separated, platform-qualified actor IDs allowed to use the
# shared Atlas identity. Keep the "slack:" prefix for Slack member IDs.
CHAT_ALLOWED_USER_IDS=slack:U0123456789

# Agent Engine invocation target. Keep "gateway" for a deployed workspace. For a
# fully local agent, set "local" and use http://localhost:3000 as the base URL;
# the service-account credentials and project/workspace IDs can then remain
# empty.
AGENTIC_INVOKE_TARGET=gateway
# Optional; defaults to the platform gateway or local Playground for the
# selected target. Gateway calls exchange the service-account pair for a
# short-lived bearer token; the client secret is shown only once when created.
AGENTIC_BASE_URL=
AGENTIC_SA_CLIENT_ID=
AGENTIC_SA_CLIENT_SECRET=
AGENTIC_PROJECT_ID=
AGENTIC_WORKSPACE_ID=

# Required for Vercel. Local Socket Mode starts an ephemeral in-memory MongoDB
# server when this is blank; both Chat SDK and workflow state use it.
MONGODB_URI=
THREAD_STORE_DB=atlas_explorer_slack
