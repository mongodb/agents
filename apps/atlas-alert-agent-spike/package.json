{
  "name": "@repo/atlas-alert-agent-spike",
  "version": "0.0.0",
  "private": true,
  "description": "EAI-2488 spike: Atlas alert webhook to Agent Engine agent to Slack",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prebuild": "pnpm --filter @repo/agent-engine-chat build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @repo/agent-engine-chat build",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter @repo/agent-engine-chat build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@repo/agent-engine-chat": "workspace:*",
    "@vercel/functions": "^3.9.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
