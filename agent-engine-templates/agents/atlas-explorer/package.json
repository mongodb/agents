{
  "name": "atlas-explorer",
  "version": "0.1.0",
  "description": "MongoDB Atlas Explorer deep agent for the Magenta Agentic Platform",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "main": "dist/agent_atlas_explorer/main.js",
  "bin": {
    "atlas-explorer": "dist/agent_atlas_explorer/main.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node --enable-source-maps dist/agent_atlas_explorer/main.js",
    "dev": "tsx watch src/agent_atlas_explorer/main.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.4.0",
    "@langchain/cerebras": "^1.0.4",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.1.0",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.7",
    "@mongodb-js/agent-engine-sdk-langgraph": "0.11.6",
    "@mongodb-js/agent-engine-runner-shared": "0.11.6",
    "@mongodb-js/agent-engine-sdk": "0.11.6",
    "dotenv": "^16.4.5",
    "langchain": "^1.5.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@langchain/langgraph-checkpoint-mongodb": "^1.4.1",
    "@types/node": "^25.0.0",
    "mongodb": "^6.21.0",
    "mongodb-memory-server-core": "11.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}