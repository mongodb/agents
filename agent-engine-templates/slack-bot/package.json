{
  "name": "@mongodb/atlas-explorer-slack-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Chat SDK client for the Magenta Atlas Explorer agent",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "vercel": "pnpm dlx --allow-build=esbuild vercel",
    "deploy": "vercel deploy --prod --yes"
  },
  "dependencies": {
    "@chat-adapter/slack": "4.40.0",
    "@vercel/functions": "^3.9.5",
    "chat": "4.40.0",
    "dotenv": "^17.4.2",
    "mongodb": "^7.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@chat-adapter/tests": "4.40.0",
    "@types/node": "^25.0.0",
    "mongodb-memory-server-core": "11.2.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
