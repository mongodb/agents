{
  "name": "@repo/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared testing for MongoDB agents",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @repo/agent-engine-chat build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @repo/agent-engine-chat build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --filter @repo/agent-engine-chat build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@langchain/langgraph-checkpoint-mongodb": "^1.4.1",
    "@repo/agent-engine-chat": "workspace:*",
    "mongodb": "^6.21.0",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=24"
  }
}
