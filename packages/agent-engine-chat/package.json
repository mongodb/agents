{
  "name": "@mongodb-js/agent-engine-chat",
  "version": "0.1.0",
  "description": "Chat SDK client library for any Atlas Agent Engine agent",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mongodb/agents/tree/main/packages/agent-engine-chat#readme",
  "bugs": {
    "url": "https://github.com/mongodb/agents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mongodb/agents.git",
    "directory": "packages/agent-engine-chat"
  },
  "type": "module",
  "exports": {
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "import": "./dist/chat/index.js"
    },
    "./agent-engine": {
      "types": "./dist/agent-engine/index.d.ts",
      "import": "./dist/agent-engine/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./testing": {
      "types": "./dist/chat/handlers.test-helpers.d.ts",
      "import": "./dist/chat/handlers.test-helpers.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "mongodb": "^7.6.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "chat": "^4.40.0",
    "mongodb-memory-server-core": "^11.2.0",
    "vitest": "^4.1.11 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "mongodb-memory-server-core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chat-adapter/slack": "4.40.0",
    "@chat-adapter/tests": "4.40.0",
    "@types/node": "^25.0.0",
    "chat": "4.40.0",
    "mongodb-memory-server-core": "11.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
