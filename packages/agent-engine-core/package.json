{
  "name": "@mongodb-js/agent-engine-core",
  "version": "0.1.0",
  "description": "Shared Agent Engine agent runtime: LLM selection, tool policy, and LangGraph middleware",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mongodb/agents/tree/main/packages/agent-engine-core#readme",
  "bugs": {
    "url": "https://github.com/mongodb/agents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mongodb/agents.git",
    "directory": "packages/agent-engine-core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:knowledge": "vitest run --config vitest.integration.config.ts tests/integration/knowledgeTools.integration.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.4.0",
    "@langchain/cerebras": "^1.0.4",
    "@langchain/google-genai": "^2.1.0",
    "@langchain/openai": "^1.4.7"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.3.0",
    "@mongodb-js/agent-engine-runner-shared": "^0.11.6",
    "@mongodb-js/agent-engine-sdk": "^0.11.6",
    "@mongodb-js/mcp-tools-assistant": "^3.0.5",
    "langchain": "^1.5.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/langgraph-checkpoint-mongodb": "^1.4.1",
    "@mongodb-js/agent-engine-runner-shared": "0.11.6",
    "@mongodb-js/agent-engine-sdk": "0.11.6",
    "@mongodb-js/mcp-tools-assistant": "3.0.5",
    "@types/node": "^25.0.0",
    "langchain": "^1.5.10",
    "mongodb": "^6.21.0",
    "mongodb-memory-server-core": "11.2.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "zod": "4.4.3"
  }
}
