{
  "name": "@repo/query-analysis-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Query Analysis agent policies, prompts, and middleware",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @repo/agent-engine-core build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @repo/agent-engine-core build",
    "test": "vitest run",
    "pretest:watch": "pnpm --filter @repo/agent-engine-core build",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --filter @repo/agent-engine-core build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@repo/agent-engine-core": "workspace:*",
    "langchain": "^1.5.10"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
