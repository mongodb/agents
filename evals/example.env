# Copy to .env in this folder. It is git-ignored; never commit it. Values override inherited shell exports.

# --- Agent Engine invoke API ---------------------------------------------
# Target the project containing the deployed agents, not their backing Atlas database project.
AE_BASE_URL=https://agentengine.mongodb.com
AE_PROJECT_ID=

# Local auth: set AE_AUTH=cli to use ~/.agentengine/auth.json for this exact host.
# This takes precedence over any service-account credentials below.
AE_AUTH=

# Auth: EITHER a service account scoped to the target Agent Engine project ...
AE_SA_CLIENT_ID=
AE_SA_CLIENT_SECRET=
# ... OR an Agent Engine API key sent as "Authorization: Bearer <key>".
AE_API_KEY=

# Workspace IDs. Leave one blank to skip every case that targets it.
AE_WS_EXPLORER_READONLY=
AE_WS_EXPLORER_WRITE=
AE_WS_QUERY_INSIGHTS=
# Set to "write" to run read-only cases on the write workspace when there's no
# read-only workspace yet. X1 is skipped because it needs a read-only credential.
AE_READONLY_FALLBACK=

# --- Case placeholders ------------------------------------------------------
# Existing Atlas cluster for Q2-live-report and Q4-list-collections-qualified.
EVAL_ATLAS_CLUSTER=
# Cluster Query Insights should analyze (Q2, X7).
QI_CLUSTER=""
# Seed start time in UTC ISO 8601 for exact seeded PA windows (Q2/X7).
EVAL_SEED_SINCE=
# A cluster in the same project that is NOT the Query Insights pin (X11).
QI_OTHER_CLUSTER=
# A real Atlas project ID the credential should NOT reach (X11). Optional.
OTHER_PROJECT_ID=

# --- Optional additive seed (X6, X7, Q2) --------------------------------------
# A write connection to a DISPOSABLE test cluster you own, plus that cluster's SRV
# hostname. The seed runner refuses to run unless the URI host equals SEED_EXPECTED_HOST.
# node src/seed.ts --apply keeps existing documents and indexes.
SEED_MONGODB_URI=
SEED_EXPECTED_HOST=

# --- LLM judge (optional) -------------------------------------------------------
# Any OpenAI- or Anthropic-compatible gateway works. Use a different model family from
# the agent under test. The GROVE_ prefix is historical.
# Example: GROVE_BASE_URL=https://<your-gateway>/openai/v1
GROVE_BASE_URL=
GROVE_API_KEY=
# anthropic -> /messages; openai -> /chat/completions; openai-responses -> /responses.
GROVE_API_STYLE=openai
GROVE_MODEL=
# bearer -> "Authorization: Bearer"; x-api-key; api-key (Azure style)
GROVE_AUTH=bearer
# Set to "none" if the model rejects a temperature parameter.
GROVE_TEMPERATURE=0

# Optional: user id sent with each invocation. Set to your CLI user id (`agentengine auth status`) if the
# platform rejects the default `eval:runner` with HTTP 403.
EVAL_ACTOR_ID=
