# Copy this file to .env before running `agentengine dev up`.
# `agent.yaml` owns app metadata. `.env` should only contain local secrets.

# MongoDB connection used by Agent Engine for LangGraph checkpoints and traces.
# Leave empty for local `agentengine dev`; the CLI provides its local MongoDB URI.
MONGODB_URI=

# Runtime database for checkpoints and traces.
MDB_AGENTIC_STORE_DB=query_analysis

# Atlas Managed MCP client credentials. Create a project MCP configuration
# with GROUP_DATA_ACCESS_READ_ONLY and copy its credentials here.
ATLAS_MCP_CLIENT_ID=
ATLAS_MCP_CLIENT_SECRET=

# LLM credentials. config.ts selects OpenAI gpt-6-luna by default.
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL.
OPENAI_BASE_URL=
# auto (default), true, or false. Reasoning models use Responses by default.
OPENAI_USE_RESPONSES_API=auto
