# Copy this file to .env before running `agentengine dev up`.
# `agent.yaml` owns app metadata. `.env` should only contain local secrets.

# MongoDB connection used by Agent Engine for LangGraph checkpoints and traces.
# Leave empty for local `agentengine dev`; the CLI provides its local MongoDB URI.
MONGODB_URI=

# Runtime database for checkpoints and traces.
MDB_AGENTIC_STORE_DB=atlas_query_insights

# Atlas Managed MCP client credentials. Create a project MCP configuration
# with GROUP_DATA_ACCESS_READ_ONLY and copy its credentials here.
ATLAS_MCP_CLIENT_ID=
ATLAS_MCP_CLIENT_SECRET=

# LLM credentials. config.ts selects OpenAI gpt-6.1-sol by default. If you
# change the provider, set the corresponding key and update agent.yaml.

# Anthropic API key.
ANTHROPIC_API_KEY=
# Optional Anthropic-compatible base URL (e.g. Azure Foundry).
ANTHROPIC_BASE_URL=

# OpenAI or OpenAI-compatible API key.
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (e.g. Azure Foundry, Azure OpenAI).
OPENAI_BASE_URL=
# Required when OPENAI_BASE_URL targets Azure OpenAI. Leave commented out
# otherwise: `agentengine deploy` requires every populated key in .env to
# exist as a platform secret.
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# auto (default), true, or false. Reasoning models use Responses by default.
OPENAI_USE_RESPONSES_API=auto
