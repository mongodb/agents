{
  "name": "atlas-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "MongoDB Atlas Explorer deep agent for Agent Engine",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "main": "dist/agent_atlas_explorer/main.js",
  "bin": {
    "atlas-explorer": "dist/agent_atlas_explorer/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && atlas-explorer-agent sync-skills",
    "pretest": "pnpm --filter @repo/testing build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "pnpm --filter @repo/testing build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretypecheck": "pnpm --filter @repo/testing build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prestart": "npm run build",
    "start": "node --enable-source-maps dist/agent_atlas_explorer/main.js",
    "dev": "tsx watch src/agent_atlas_explorer/main.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.3.0",
    "@mongodb-js/agent-engine-runner-shared": "0.11.6",
    "@mongodb-js/agent-engine-sdk-langgraph": "0.11.6",
    "@mongodb-js/agent-engine-sdk": "0.11.6",
    "@mongodb-js/atlas-agents-core": "^0.1.4",
    "@mongodb-js/atlas-explorer-agent": "^0.1.4",
    "@mongodb-js/mcp-tools-assistant": "3.0.5",
    "dotenv": "^16.4.5",
    "langchain": "^1.5.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}