{
  "name": "atlas-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "MongoDB Atlas Explorer deep agent for the Magenta Agentic Platform",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "main": "dist/agent_atlas_explorer/main.js",
  "bin": {
    "atlas-explorer": "dist/agent_atlas_explorer/main.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @repo/atlas-explorer-agent build",
    "build": "esbuild src/agent_atlas_explorer/main.ts --bundle --platform=node --format=esm --outfile=dist/agent_atlas_explorer/main.js --sourcemap --external:@langchain/* --external:@mongodb-js/* --external:langchain --external:zod --external:dotenv",
    "pretest": "pnpm --filter @repo/atlas-explorer-agent build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretypecheck": "pnpm --filter @repo/atlas-explorer-agent build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prestart": "pnpm run build",
    "start": "node --enable-source-maps dist/agent_atlas_explorer/main.js",
    "predev": "pnpm --filter @repo/atlas-explorer-agent build",
    "dev": "tsx watch src/agent_atlas_explorer/main.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.3.0",
    "@mongodb-js/agent-engine-sdk-langgraph": "0.11.6",
    "@mongodb-js/agent-engine-sdk": "0.11.6",
    "@repo/atlas-explorer-agent": "workspace:*",
    "dotenv": "^16.4.5",
    "langchain": "^1.5.10"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}